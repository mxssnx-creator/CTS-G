[Unit]
Description=Independent pulse desk for %i
After=network-online.target redis.service
Wants=network-online.target
PartOf=grok-pulse.target

[Service]
Type=notify
NotifyAccess=all
WatchdogSec=300
WatchdogSignal=SIGKILL
WorkingDirectory=/opt/grok-x01-pulse
ExecStart=/usr/bin/python3 -O /opt/grok-x01-pulse/pulse_trader.py
Restart=always
RestartSec=2
StartLimitBurst=20
StartLimitIntervalSec=120
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PULSE_CONN=%i
Nice=-5
CPUWeight=200
MemoryHigh=400M
MemoryMax=640M
TasksMax=128
LimitNOFILE=4096
OOMPolicy=kill
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
