[Unit]
Description=CTS-G pulse engine (%i)
Documentation=https://github.com/mxssnx-creator/CTS-G
After=network-online.target redis-server.service redis.service grok-pulse-http.service
Wants=network-online.target
PartOf=grok-pulse.target
StartLimitBurst=20
StartLimitIntervalSec=120

[Service]
Type=notify
NotifyAccess=all
# A full symbol slice can legitimately run for several minutes while the
# bounded replay emits inner WATCHDOG heartbeats. Keep a generous systemd
# safety ceiling so reclaim/CPU scheduling cannot kill a healthy long slice.
WatchdogSec=900
WatchdogSignal=SIGKILL
EnvironmentFile=-/etc/cts-g/cts-g.env
EnvironmentFile=-/etc/cts-g/credentials.env
WorkingDirectory=/opt/grok-x01-pulse
ExecStart=/usr/bin/python3 -O /opt/grok-x01-pulse/pulse_trader.py
Restart=always
RestartSec=2
TimeoutStartSec=90
TimeoutStopSec=25
KillMode=mixed
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PULSE_CONN=%i
Nice=-5
CPUWeight=200
# A 25-symbol 34,320-set catalog plus klines sits around 2.4–2.6G RSS.
# MemoryHigh must stay above that working set; reclaim at 2304M turned the
# first hist slice into a multi-minute futex stall (mem_cgroup_handle_over_high).
MemoryHigh=3456M
MemoryMax=3840M
MemorySwapMax=0
TasksMax=128
LimitNOFILE=4096
OOMPolicy=kill
StandardOutput=append:/var/log/cts-g/pulse-%i.log
StandardError=append:/var/log/cts-g/pulse-%i.err.log
SyslogIdentifier=grok-pulse-%i

[Install]
WantedBy=multi-user.target
WantedBy=grok-pulse.target
