# CTS-G Linux runtime. Copied to /etc/cts-g/cts-g.env on first install.
# Existing /etc/cts-g/cts-g.env is never overwritten by update.

# Git
# origin https://github.com/mxssnx-creator/CTS-G.git
# user.email mxssnx@gmail.com
# user.name xssnet

# Local sidecar (desk talks here instead of a remote VPS).
PULSE_URL=http://127.0.0.1:3015
PULSE_PORT=3015
CTS_URL=http://127.0.0.1

# Pulse engine
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Desk (Linux default :3102 — does not collide with old CTS :3002)
HOST=0.0.0.0
PORT=3102

# Every named installation owns independent persistent state, runtime logs,
# systemd units and a Redis logical DB. Keep ports/DB unique across installs.
CTS_G_NAME=cts-g
CTS_G_ROOT=/opt/cts-g
CTS_SYSTEMD_PREFIX=cts-g
CTS_STATE_DIR=/var/lib/cts/instances/cts-g
CTS_DATA_DIR=/var/lib/cts/instances/cts-g/data
CTS_DB_DIR=/var/lib/cts/instances/cts-g/db
CTS_LOG_DIR=/var/log/cts-g
PULSE_DIR=/opt/cts-g-pulse
CTS_REDIS_DB=1

# Diagnostics are retained at the newest 1,000 lines and at most 8 MiB per
# physical file. journald is independently limited to 256 MiB / seven days.
CTS_LOG_MAX_LINES=1000
CTS_LOG_MAX_BYTES=8388608
CTS_JOURNAL_MAX_USE=256M

# Optional: BingX REST override (default https://open-api.bingx.com)
# PULSE_BASE=https://open-api.bingx.com
