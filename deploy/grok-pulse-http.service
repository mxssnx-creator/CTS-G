[Unit]
Description=CTS-G pulse HTTP sidecar (:3015)
Documentation=https://github.com/mxssnx-creator/CTS-G
After=network-online.target
Wants=network-online.target
PartOf=grok-pulse.target

[Service]
Type=simple
EnvironmentFile=-/etc/cts-g/cts-g.env
EnvironmentFile=-/etc/cts-g/credentials.env
WorkingDirectory=/opt/grok-x01-pulse
ExecStart=/usr/bin/python3 -O /opt/grok-x01-pulse/pulse_http.py
Restart=always
RestartSec=2
TimeoutStopSec=15
KillMode=mixed
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
LimitNOFILE=4096
StandardOutput=append:/var/log/cts-g/pulse-http.log
StandardError=append:/var/log/cts-g/pulse-http.err.log
SyslogIdentifier=grok-pulse-http
LogRateLimitIntervalSec=300s
LogRateLimitBurst=300

[Install]
WantedBy=multi-user.target
WantedBy=grok-pulse.target
