+        n = int(getattr(self.block, "window", 25) or 25)
+        res = last_n_cost_pf(rows, n=n, cost_pct=self.position_cost_pct)
+        if int(res.get("count") or 0) < int(getattr(self.block, "min_samples", 5) or 5):
+            return 0.0
