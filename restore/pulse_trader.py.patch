+def ctrl_mtimes(paths) -> Dict[str, float]:
+    """mtime snapshot of the control files; missing files map to 0.0, so a
+    create/delete/touch anywhere always changes the snapshot."""
+    out: Dict[str, float] = {}
+    for p in paths:
+        try:
+            out[p] = os.path.getmtime(p)
+        except OSError:
+            out[p] = 0.0
+    return out
